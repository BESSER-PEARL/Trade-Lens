[Unit]
Description=Luxembourg Trade Explorer: backend (FastAPI)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/opt/statec
Environment=DATABASE_URL=sqlite:////opt/statec/data/lux_trade.db
Environment=VIEW_STATE_PATH=/opt/statec/data/view_state.json
Environment=VIEW_MAX_AGENT_PANELS=8
UnsetEnvironment=PYTHONPATH
ExecStart=/opt/statec/.venv/bin/python -m uvicorn main_api:app --app-dir app/backend --host 127.0.0.1 --port 8000 --timeout-graceful-shutdown 3
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
