# Copy to .env (gitignored) and fill in. Read by the agent (app/agents/lux_insights) at start.

# The default: OpenAI (the specialists on gpt-6-luna, the router's plan on gpt-4o-mini).
OPENAI_API_KEY=

# Or Mistral instead of OpenAI (uncomment one; everything else stays the same):
# LUX_LLM=mistral-local         # Mistral on this machine with Ollama: `ollama pull mistral-small`; nothing leaves the machine
# LUX_LLM=mistral               # Mistral's API, with MISTRAL_API_KEY below
# MISTRAL_API_KEY=

# Or any other OpenAI-compatible server (Ollama, LM Studio, vLLM...):
# LUX_LLM_BASE_URL=http://localhost:11434/v1
# LUX_LLM_API_KEY=              # if the server needs one
# LUX_AGENT_MODEL=mistral-small # required with LUX_LLM_BASE_URL

# Optional:
# LUX_AGENT_MODEL=gpt-6-luna    # the specialists' model
# LUX_ROUTER_MODEL=gpt-4o-mini  # the router's plan only (with another provider: the same model by default)
# LUX_AGENT_PORT=8766
# LUX_API_URL=http://localhost:8000
