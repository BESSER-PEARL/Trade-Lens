def _value_expr(alias: str = "o") -> str:
    """The observed value in real units: SDMX UNIT_MULT=6 means 'in millions'."""
    v = f'{alias}."{VALUE}"'
    if not UNIT_MULT:
        return v
    cases = " ".join(f"WHEN '{k}' THEN 1e{k}" for k in range(-6, 13))
    return f'({v} * (CASE {alias}."{UNIT_MULT}" {cases} ELSE 1 END))'


