def _dim(dim_id: str) -> dict:
    if dim_id not in DIMS:
        raise HTTPException(400, f"Unknown dimension {dim_id!r}; known: {sorted(DIMS)}")
    return DIMS[dim_id]


def _normalise(dim: dict, value: str) -> str:
    """Accept SDMX codes or enum literal names for enumerated dimensions."""
    if dim["kind"] == "enum":
        return dim["literals"].get(value, value)
    return value


_KNOWN: dict[str, set] = {}


def _known_codes(db: Session, dim: dict) -> set:
    if dim["id"] not in _KNOWN:
        if dim["kind"] == "enum":
            _KNOWN[dim["id"]] = set(dim["literals"].values())
        elif dim["kind"] == "class":
            _KNOWN[dim["id"]] = {r[0] for r in db.execute(text(f'SELECT code FROM "{dim["table"]}"')).fetchall()}
        else:
            return set()
    return _KNOWN[dim["id"]]


def _check(db: Session, dim: dict, values: list[str]) -> None:
    """Unknown codes are a 400, not an empty answer that looks like 'no trade'."""
    if dim["kind"] not in ("enum", "class"):
        return
    known = _known_codes(db, dim)
    bad = [v for v in values if v not in known]
    if bad:
        raise HTTPException(400, f"Unknown code(s) {bad} for dimension {dim['id']!r}")


def _filters(request: Request, exclude: set[str], db: Optional[Session] = None) -> dict[str, list[str]]:
    """Dimension filters from the query string, completed with the configured defaults."""
    out: dict[str, list[str]] = {}
    for key, raw in request.query_params.items():
        if key in RESERVED or key not in DIMS or key in exclude:
            continue
        out[key] = [_normalise(DIMS[key], v) for v in raw.split(",") if v != ""]
        if db is not None:
            _check(db, DIMS[key], out[key])
    for dim_id, default in DEFAULTS.items():
        if dim_id not in out and dim_id not in exclude and default is not None:
            values = default if isinstance(default, list) else [default]
            out[dim_id] = [_normalise(DIMS[dim_id], v) for v in values]
    return out


def _where(filters: dict[str, list[str]], params: dict, alias: str = "o") -> list[str]:
    clauses = []
    for i, (dim_id, values) in enumerate(filters.items()):
        col = DIMS[dim_id]["column"]
        names = []
        for j, v in enumerate(values):
            p = f"f{i}_{j}"
            params[p] = v
            names.append(f":{p}")
        clauses.append(f'{alias}."{col}" IN ({", ".join(names)})')
    return clauses


def _clean(label: str) -> str:
    """Readable labels: drop Eurostat's historical notes "(incl. ...)" and un-shout ALL-CAPS names."""
    label = label.replace(" ", " ")
    cut = label.find(" (incl.")
    if cut > 0:
        label = label[:cut]
    letters = [c for c in label if c.isalpha()]
    if letters and sum(c.isupper() for c in letters) / len(letters) > 0.8:
        label = label[:1].upper() + label[1:].lower()
    return re.sub(r"\s+", " ", label).strip()


def _enum_label(dim: dict, literal: str) -> str:
    """Codelist name of an enum value (Imports, Exports...), else a readable form of the literal."""
    code = _CODE_OF.get(dim["id"], {}).get(literal, literal)
    name = CODE_LABELS.get(dim["id"], {}).get(code) or literal
    if " " not in name:  # a code-like name (VALUE_IN_EUROS): make it readable
        name = name.replace("_", " ").lower().capitalize()
    return _clean(name)


def _labels(db: Session, dim: dict, codes: list[str]) -> dict[str, str]:
    if dim["kind"] == "enum":
        return {c: _enum_label(dim, c) for c in codes}
    if dim["kind"] != "class" or not codes:
        return {c: c for c in codes}
    params = {f"c{i}": c for i, c in enumerate(codes)}
    rows = db.execute(text(f'SELECT code, label FROM "{dim["table"]}" WHERE code IN ({", ".join(":" + k for k in params)})'),
                      params).fetchall()
    found = {r[0]: _clean(r[1] or r[0]) for r in rows}
    return {c: found.get(c, c) for c in codes}


def _level_of(db: Session, dim: dict, code: str) -> int:
    row = db.execute(text(f'SELECT level FROM "{dim["table"]}" WHERE code = :c'), {"c": code}).fetchone()
    return int(row[0]) if row and row[0] is not None else 0


def _is_member(dim: dict, code: str, db: Optional[Session] = None) -> bool:
    """A "real" item of a dimension: not its total, matching its member pattern (countries, not
    aggregates) and, for a geographic hierarchy, a leaf (DE, not EU27)."""
    pattern = dim.get("member_pattern")
    total = dim.get("total_code")
    if total and code == total:
        return False
    if pattern and not re.fullmatch(pattern, code):
        return False
    if db is not None and dim.get("role") == "geo" and dim.get("hierarchy"):
        if dim["id"] not in _PARENT_CODES:
            rows = db.execute(text(f'SELECT DISTINCT "{dim["parent_column"]}" FROM "{dim["table"]}"')).fetchall()
            _PARENT_CODES[dim["id"]] = {r[0] for r in rows if r[0]}
        return code not in _PARENT_CODES[dim["id"]]
    return True


def _in_view(dim: dict, code: str, db: Session, parent: Optional[str]) -> bool:
    """Items shown for a dimension: its members, or, when drilling into ``parent``, its children."""
    if parent and dim.get("hierarchy"):
        return code != parent
    return _is_member(dim, code, db)


def _drill_level(db: Session, dim: dict, level: Optional[int], parent: Optional[str]) -> Optional[int]:
    """Level to rank at: the children of ``parent``; for a nomenclature without parent, its first
    level below the total. Geographic dimensions rank their member countries instead."""
    if not dim.get("hierarchy"):
        return None
    if level is not None:
        return level
    if parent:
        return _level_of(db, dim, parent) + 1
    if dim.get("role") == "geo":
        return None
    return 1 if dim.get("total_code") else 0


def _grouped(db: Session, by: dict, filters: dict, level: Optional[int], parent: Optional[str]) -> dict[str, float]:
    params: dict = {}
    where = _where(filters, params)
    join = ""
    if by.get("hierarchy"):
        join = f'JOIN "{by["table"]}" d ON d.code = o."{by["column"]}"'
        if level is not None:
            where.append("d.level = :lvl")
            params["lvl"] = level
        if parent:
            where.append(f'd."{by["parent_column"]}" = :parent')
            params["parent"] = parent
    sql = (f'SELECT o."{by["column"]}" AS code, SUM({VALUE_EXPR}) AS value FROM "{OBS}" o {join} '
           f'WHERE {" AND ".join(where) if where else "1=1"} GROUP BY o."{by["column"]}"')
    return {r[0]: float(r[1] or 0) for r in db.execute(text(sql), params).fetchall()}


def _value_of(db: Session, by: dict, code: str, filters: dict) -> Optional[float]:
    params: dict = {"code": code}
    where = _where(filters, params) + [f'o."{by["column"]}" = :code']
    row = db.execute(text(f'SELECT SUM({VALUE_EXPR}) FROM "{OBS}" o WHERE {" AND ".join(where)}'), params).fetchone()
    return float(row[0]) if row and row[0] is not None else None


def _default_threshold(by: dict, level: Optional[int]) -> float:
    """The significance ladder: one decimal less per level of detail."""
    base = CONFIG["base_threshold"]
    if by.get("hierarchy") and by.get("role") != "geo" and level:
        return base / (10 ** (level - 1))
    return base


def _previous(period: str) -> str:
    """The period before ``period`` (2025 -> 2024, 2025-03 -> 2025-02)."""
    if re.fullmatch(r"\d{4}", period):
        return str(int(period) - 1)
    m = re.fullmatch(r"(\d{4})-(\d{2})", period)
    if m:
        y, mo = int(m.group(1)), int(m.group(2))
        return f"{y - 1}-12" if mo == 1 else f"{y}-{mo - 1:02d}"
    return period


# --------------------------------------------------------------------------- live fetch
# A query "needs" a slice: per dimension, ("all", None) = every code, ("all_of", codes) = these
# codes, ("any_of", codes) = some of these (the children of a drilled item). The registry says
# which slices the loader (or an earlier live fetch) put in the database; anything else is
# fetched from the SDMX source, stored, and registered.
_LOCK = threading.Lock()
_FAILED: dict[str, float] = {}
_REGISTRY_CACHE: list = []
RETRY_AFTER = 120  # seconds before a failed live fetch is tried again


def _registry(db: Session) -> list[tuple[dict, Optional[str], Optional[str], str]]:
    if not _REGISTRY_CACHE:
        try:
            rows = db.execute(text(f'SELECT spec, start_period, end_period, source FROM "{REGISTRY}"')).fetchall()
        except Exception:  # database loaded before the registry existed
            db.rollback()
            rows = []
        _REGISTRY_CACHE.append([(json.loads(s), a, b, src) for s, a, b, src in rows])
    return _REGISTRY_CACHE[0]


def _sdmx_codes(dim: dict, values) -> set:
    rev = _CODE_OF.get(dim["id"], {})
    return {rev.get(v, v) for v in values}


def _needed(db: Session, filters: dict, by: Optional[dict] = None, parent: Optional[str] = None,
            level: Optional[int] = None) -> tuple[dict, dict]:
    """(needed slice, extra codes to fetch) for a query: its filters, plus what ``by`` ranks."""
    needed: dict = {}
    extra: dict = {}
    for dim_id, values in filters.items():
        d = DIMS[dim_id]
        if d.get("role") == "time":
            continue
        needed[dim_id] = ("all_of", _sdmx_codes(d, values))
    if by is not None:
        if by.get("hierarchy") and parent:
            kids = {r[0] for r in db.execute(text(f'SELECT code FROM "{by["table"]}" WHERE "{by["parent_column"]}" = :p'),
                                             {"p": parent}).fetchall()}
            needed[by["id"]] = ("any_of", kids) if kids else ("all_of", {parent})
            extra[by["id"]] = {parent}  # its total, for shares and coverage
        elif by.get("hierarchy") and level is not None:
            codes = {r[0] for r in db.execute(text(f'SELECT code FROM "{by["table"]}" WHERE level = :l'),
                                              {"l": level}).fetchall()}
            needed[by["id"]] = ("any_of", codes) if codes else ("all", None)
            if by.get("total_code"):
                extra[by["id"]] = {by["total_code"]}
        else:
            needed[by["id"]] = ("all", None)
    return needed, extra


def _in_range(start: Optional[str], end: Optional[str], a: Optional[str], b: Optional[str]) -> bool:
    if a and start and start[:len(a)] < a:
        return False
    if b and end and end[:len(b)] > b:
        return False
    return True


def _covered(db: Session, needed: dict, start: Optional[str], end: Optional[str]) -> Optional[bool]:
    """True/False from the registry; None when the database has no registry (loaded before it existed)."""
    reg = _registry(db)
    if not any(src == "load" for _, _, _, src in reg):
        return None
    for spec, a, b, _ in reg:
        if not _in_range(start, end, a, b):
            continue
        ok = True
        for dim_id, (mode, codes) in needed.items():
            have = spec.get(dim_id, "*")
            if have == "*":
                continue
            have = set(have)
            if mode == "all" or (mode == "all_of" and not codes <= have) or (mode == "any_of" and not codes & have):
                ok = False
                break
        if ok:
            return True
    return False


def _sdmx_key(needed: dict, extra: dict) -> str:
    parts = []
    for dim_id in SDMX["dimensions"]:
        mode, codes = needed.get(dim_id, ("all", None))
        if mode == "all":
            parts.append("")
        else:
            parts.append("+".join(sorted(set(codes) | extra.get(dim_id, set()))))
    return ".".join(parts)


def _fetch_and_store(db: Session, key: str, needed: dict, extra: dict, start: Optional[str], end: Optional[str]) -> int:
    import requests  # only needed for live fetches

    url = f'{SDMX["base_url"]}/data/{SDMX["flow"]}/{key}'
    params = {k: v for k, v in (("startPeriod", start), ("endPeriod", end)) if v}
    r = requests.get(url, params=params, timeout=SDMX.get("timeout", 20),
                     headers={"Accept": "application/vnd.sdmx.data+csv;version=1.0.0",
                              "User-Agent": "besser-sdmx insights (live fetch)"})
    body = "" if r.status_code == 404 else r.text  # SDMX 404 = no results
    if r.status_code not in (200, 404):
        r.raise_for_status()
    if body.lstrip().startswith("<"):
        raise RuntimeError("the provider answered XML instead of data (query too large or error)")
    records = list(csv.DictReader(io.StringIO(body))) if body.strip() else []
    if records:
        lower = {c.lower(): c for c in records[0]}
        dims = [d for d in CONFIG["dimensions"] if d.get("role") != "time"]
        src = {d["id"]: lower.get(d["id"].lower()) for d in dims}
        missing = [d for d, c in src.items() if c is None]
        if missing:
            raise RuntimeError(f"columns {missing} not in the provider's data")
        attrs = {col: lower.get(sid.lower()) for sid, col in (SDMX.get("attributes") or {}).items()}
        rows, unknown = [], {}
        for rec in records:
            row = {}
            skip = False
            for d in dims:
                code = rec[src[d["id"]]]
                if d["kind"] == "enum":
                    lit = d["literals"].get(code)
                    if lit is None:
                        skip = True
                        break
                    row[d["column"]] = lit
                else:
                    row[d["column"]] = code
                    if d["kind"] == "class" and code not in _known_codes(db, d):
                        unknown.setdefault(d["id"], set()).add(code)
            if skip:
                continue
            row[TIME] = rec[lower["time_period"]]
            raw = rec.get(lower.get("obs_value", ""), "")
            row[VALUE] = float(raw) if raw not in ("", None) else None
            for col, c in attrs.items():
                row[col] = (rec.get(c) or None) if c else None
            rows.append(row)
        for dim_id, codes in unknown.items():  # e.g. product codes newer than the codelist
            d = DIMS[dim_id]
            cols = "code, label" + (", level" if d.get("hierarchy") else "")
            vals = ":c, :c" + (", 0" if d.get("hierarchy") else "")
            db.execute(text(f'INSERT INTO "{d["table"]}" ({cols}) VALUES ({vals})'), [{"c": c} for c in sorted(codes)])
            _known_codes(db, d).update(codes)
        if rows:
            keys = [d["column"] for d in dims] + [TIME]
            cond = " AND ".join(f'"{k}" = :{k}' for k in keys)
            db.execute(text(f'DELETE FROM "{OBS}" WHERE {cond}'), [{k: r[k] for k in keys} for r in rows])
            cols = list(rows[0])
            db.execute(text(f'INSERT INTO "{OBS}" ({", ".join(chr(34) + c + chr(34) for c in cols)}) '
                            f'VALUES ({", ".join(":" + c for c in cols)})'), rows)
    spec = {dim_id: ("*" if mode == "all" else sorted(set(codes) | extra.get(dim_id, set())))
            for dim_id, (mode, codes) in needed.items()}
    db.execute(text(f'CREATE TABLE IF NOT EXISTS "{REGISTRY}" (id INTEGER PRIMARY KEY AUTOINCREMENT, '
                    'spec TEXT NOT NULL, start_period TEXT, end_period TEXT, rows INTEGER, source TEXT, loaded_at TEXT)'))
    db.execute(text(f'INSERT INTO "{REGISTRY}" (spec, start_period, end_period, rows, source, loaded_at) '
                    'VALUES (:spec, :start, :end, :rows, :source, :at)'),
               {"spec": json.dumps(spec, sort_keys=True), "start": start, "end": end, "rows": len(records),
                "source": "live", "at": datetime.now(timezone.utc).isoformat(timespec="seconds")})
    db.commit()
    _REGISTRY_CACHE.clear()
    return len(records)


def _ensure(db: Session, needed: dict, extra: dict, start: Optional[str], end: Optional[str],
            probe: Callable[[], bool]) -> dict:
    """Make sure the slice a query needs is in the database; fetch it live if it never was.

    Returns flags for the response: ``fetched_live`` (it came from the source during this request)
    and ``loaded`` (False: not in the database and the source could not be reached).
    """
    status = {"fetched_live": False, "loaded": True}
    if not SDMX:
        return status
    covered = _covered(db, needed, start, end)
    if covered is None:  # no registry: whatever is in the database counts as loaded
        covered = probe()
    if covered:
        return status
    key = _sdmx_key(needed, extra)
    tag = f"{key}|{start}|{end}"
    with _LOCK:
        if _covered(db, needed, start, end):  # fetched by a concurrent request meanwhile: re-query
            return {"fetched_live": True, "loaded": True, "source": SDMX.get("name")}
        if time.time() - _FAILED.get(tag, 0) < RETRY_AFTER:
            return {**status, "loaded": False}
        try:
            rows = _fetch_and_store(db, key, needed, extra, start, end)
        except Exception as exc:  # offline, timeout, provider error: say so, never show zeros
            db.rollback()
            _FAILED[tag] = time.time()
            return {**status, "loaded": False, "error": str(exc)[:200]}
    return {"fetched_live": True, "loaded": True, "fetched_rows": rows, "source": SDMX.get("name")}


def _window(period: str, previous: Optional[str] = None) -> tuple[str, str]:
    """The span of two compared periods, in order."""
    a, b = sorted((previous or _previous(period), period))
    return a, b


# --------------------------------------------------------------------------- rankings
def _span(start: str, end: str) -> str:
    """The years a ranking sums over, as words for a text fact: 2025, or 2020–2025."""
    return str(end) if str(start) == str(end) else f"{start}–{end}"


def _ranking_periods(request: Request, period: str, filters: dict) -> tuple[str, str]:
    """Apply an inclusive annual range, or keep the existing single-period query."""
    start, end = request.query_params.get("start"), request.query_params.get("end")
    # start = end = period (a page that follows $start and $period on a single year or a month) is
    # the single-period query, so a month keeps reading the monthly data.
    if start in (None, period) and end in (None, period):
        filters[CONFIG["time_dimension"]] = [period]
        return period, period
    start, end = start or period, end or period
    if not re.fullmatch(r"[0-9]{4}", start) or not re.fullmatch(r"[0-9]{4}", end) or not (1 <= int(start) <= int(end) <= 9999):
        raise HTTPException(400, "Use an inclusive annual range with start <= end (YYYY).")
    freq = next((d for d in CONFIG["dimensions"] if d["id"] == "freq"), None)
    if freq and filters.get("freq") != [_normalise(freq, "A")]:
        raise HTTPException(400, "Year ranges require annual frequency (freq=A).")
    filters[CONFIG["time_dimension"]] = [str(y).zfill(4) for y in range(int(start), int(end) + 1)]
    return start, end


def _ranking(db: Session, request: Request, by_id: str, period: str, level: Optional[int], parent: Optional[str],
             threshold: Optional[float], max_items: int, relative_to: str) -> dict:
    by = _dim(by_id)
    filters = _filters(request, exclude={by_id}, db=db)
    start, end = _ranking_periods(request, period, filters)
    if parent:
        _check(db, by, [parent])
    level = _drill_level(db, by, level, parent)

    def query() -> dict:
        values = _grouped(db, by, filters, level, parent)
        return {c: v for c, v in values.items() if _in_view(by, c, db, parent) and v > 0}

    items = query()
    needed, extra = _needed(db, filters, by, parent, level)
    status = _ensure(db, needed, extra, start, end, probe=lambda: bool(items))
    if status["fetched_live"]:
        items = query()
    if not status["loaded"]:
        return {"by": by_id, "period": period, "start": start, "end": end, "span": _span(start, end), "level": level, "parent": parent, "total": None, "base_total": None,
                "items": [], "other": None, **status}

    # Two totals: `view` is the value of what is on screen (the parent when drilling, else the
    # dimension's total) and gives the coverage and the "Other" bucket; `base` is what shares are
    # expressed in (the dimension's total, or the parent with relative_to=parent).
    view, base = _totals(db, by, filters, parent, relative_to, items)
    if not view or not base:
        return {"by": by_id, "period": period, "start": start, "end": end, "span": _span(start, end), "level": level, "parent": parent, "total": 0, "base_total": 0,
                "items": [], "other": None, **status}

    threshold = _default_threshold(by, level) if threshold is None else threshold
    ranked = sorted(items.items(), key=lambda kv: -kv[1])
    kept = [(c, v) for c, v in ranked if v / base >= threshold][:max_items]
    labels = _labels(db, by, [c for c, _ in kept])
    cum = 0.0
    out = []
    for rank, (c, v) in enumerate(kept, 1):
        cum += v
        out.append({"rank": rank, "code": c, "name": labels[c], "value": v, "share": v / base, "cum_share": cum / base})
    hidden = ranked[len(kept):]
    hidden_value = sum(v for _, v in hidden)
    # Value in view that no listed item accounts for: confidential or unallocated trade.
    unallocated = max(view - cum - hidden_value, 0.0)
    return {
        "by": by_id, "period": period, "start": start, "end": end, "span": _span(start, end), "level": level, "parent": parent, "threshold": threshold,
        "relative_to": relative_to, "total": view, "base_total": base, "coverage": cum / view, "items": out,
        "other": {"name": f"Other ({len(hidden)})", "value": hidden_value, "share": hidden_value / base,
                  "count": len(hidden)} if hidden else None,
        "unallocated": {"value": unallocated, "share": unallocated / base} if unallocated > 0.005 * view else None,
        **status,
    }


def _totals(db: Session, by: dict, filters: dict, parent: Optional[str], relative_to: str,
            items: dict[str, float]) -> tuple[float, float]:
    """(view total, base for shares) of a ranking; see _ranking."""
    total_code = by.get("total_code")
    dim_total = (_value_of(db, by, total_code, filters) if total_code else None) or sum(items.values())
    if not parent:
        return dim_total, dim_total
    parent_total = _value_of(db, by, parent, filters) or sum(items.values())
    return parent_total, (parent_total if relative_to == "parent" else dim_total)


# --------------------------------------------------------------------------- endpoints
def _unit(db: Session) -> dict:
    """Currency/unit of the values, from the codes the unit-like dimensions are fixed to."""
    words = []
    for d in CONFIG["dimensions"]:
        code = DEFAULTS.get(d["id"])
        if d.get("role") != "unit" or code is None:
            continue
        if d["kind"] == "enum":
            lit = _normalise(d, code)
            words += [lit, _enum_label(d, lit)]
        elif d["kind"] == "class":
            words += [code, _labels(db, d, [code])[code]]
    text_ = " ".join(words)
    symbol = "€" if re.search(r"EUR|EURO", text_, re.I) else "$" if re.search(r"USD|DOLLAR", text_, re.I) else \
        "%" if re.search(r"PERCENT|PC_|%", text_, re.I) else ""
    multiplier = 1.0
    if not UNIT_MULT:  # the unit's name may carry the scale ("Current prices, million euro")
        for word, m in (("thousand", 1e3), ("million", 1e6), ("billion", 1e9), ("MEUR", 1e6), ("MIO", 1e6)):
            if re.search(word, text_, re.I):
                multiplier = m
                break
    return {"symbol": symbol, "multiplier": multiplier, "label": text_}


@router.get("/meta")
def meta(db: Session = Depends(get_db)):
    """Dimensions, their codes or literals, and the periods available per frequency.

    Computed once per process: the data only changes when the loader runs again.
    """
    if _META_CACHE:
        return _META_CACHE[0]
    dims = []
    for d in CONFIG["dimensions"]:
        if d.get("role") == "time":
            continue
        entry = {k: d.get(k) for k in ("id", "label", "kind", "role", "hierarchy", "total_code")}
        entry["default"] = DEFAULTS.get(d["id"])
        present = {r[0] for r in db.execute(text(f'SELECT DISTINCT "{d["column"]}" FROM "{OBS}"')).fetchall()}
        entry["n_values"] = len(present)
        if d["kind"] == "enum":
            if entry["default"] is not None:
                entry["default"] = _normalise(d, entry["default"])
            # Only the literals that actually occur in the data (a codelist may list dozens more).
            lits = sorted(v for v in set(d["literals"].values()) if v in present) or sorted(set(d["literals"].values()))
            entry["values"] = [{"code": lit, "label": _enum_label(d, lit)} for lit in lits]
        if entry["default"] is not None and d["kind"] in ("enum", "class"):
            entry["default_label"] = _labels(db, d, [entry["default"]])[entry["default"]]
        # A dimension with one value in the data (or "not applicable") is context, not a choice.
        entry["constant"] = len(present) <= 1
        entry["not_applicable"] = bool(present) and present <= NOT_APPLICABLE
        dims.append(entry)
    freq = CONFIG.get("frequency_dimension")
    periods: dict[str, list[str]] = {}
    if freq:
        col = DIMS[freq]["column"]
        rows = db.execute(text(f'SELECT DISTINCT "{col}", "{TIME}" FROM "{OBS}" ORDER BY "{TIME}"')).fetchall()
        for f, p in rows:
            periods.setdefault(f, []).append(p)
    else:
        periods["all"] = [r[0] for r in db.execute(text(f'SELECT DISTINCT "{TIME}" FROM "{OBS}" ORDER BY 1')).fetchall()]
    defaults = {k: (_normalise(DIMS[k], v) if k in DIMS else v) for k, v in DEFAULTS.items()}
    # Each frequency's periods end with the last one the headline series has (every class dimension at its
    # default: reporter LU, partner WORLD, product TOTAL). Eurostat publishes some partners a month before the
    # total (extra-EU trade for July 2026, say); a month without the total is not one the page can show.
    if freq:
        where = [(DIMS[k]["column"], v) for k, v in defaults.items()
                 if k in DIMS and DIMS[k]["kind"] == "class" and v is not None]
        if where:
            cond = " AND ".join(f'"{c}" = :w{i}' for i, (c, _) in enumerate(where))
            last = dict(db.execute(text(f'SELECT "{col}", MAX("{TIME}") FROM "{OBS}" WHERE {cond} GROUP BY "{col}"'),
                                   {f"w{i}": v for i, (_, v) in enumerate(where)}).fetchall())
            periods = {f: [p for p in ps if not last.get(f) or p <= last[f]] for f, ps in periods.items()}
    # The last year with 12 months: later months are provisional (and revised by the source).
    monthly = periods.get("M", [])
    years = sorted({p[:4] for p in monthly})
    complete = [y for y in years if sum(1 for p in monthly if p.startswith(y)) == 12]
    result = {"title": CONFIG["title"], "dataflow": CONFIG["dataflow"], "source": CONFIG.get("source"),
              "live_source": (SDMX or {}).get("name"),
              "dimensions": dims, "periods": periods, "defaults": defaults, "base_threshold": CONFIG["base_threshold"],
              "focus": FOCUS, "time_dimension": CONFIG["time_dimension"], "unit": _unit(db),
              "complete_until": f"{complete[-1]}-12" if complete else None}
    _META_CACHE.append(result)
    return result


_META_CACHE: list[dict] = []


@router.get("/ranking")
def ranking(request: Request, by: str, period: str, level: Optional[int] = None, parent: Optional[str] = None,
            threshold: Optional[float] = None, max_items: int = 15, relative_to: str = "total",
            start: Optional[str] = None, end: Optional[str] = None, db: Session = Depends(get_db)):
    """Items of one dimension ranked by value, above a significance threshold, plus an 'Other' bucket."""
    return _ranking(db, request, by, period, level, parent, threshold, max_items, relative_to)


@router.get("/ranking/records")
def ranking_records(request: Request, by: str, period: str, level: Optional[int] = None, parent: Optional[str] = None,
                    threshold: Optional[float] = None, max_items: int = 15, relative_to: str = "total",
                    start: Optional[str] = None, end: Optional[str] = None, db: Session = Depends(get_db)):
    """Same as /ranking as a flat list (name, value, share) for BESSER chart components."""
    r = _ranking(db, request, by, period, level, parent, threshold, max_items, relative_to)
    rows = [{"name": i["name"], "code": i["code"], "value": i["value"], "share": round(100 * i["share"], 3)} for i in r["items"]]
    if r.get("other") and r["other"]["value"] > 0:
        rows.append({"name": r["other"]["name"], "code": "OTHER", "value": r["other"]["value"],
                     "share": round(100 * r["other"]["share"], 3)})
    return rows


@router.get("/ladder")
def ladder(request: Request, by: str, period: str, level: Optional[int] = None, parent: Optional[str] = None,
           relative_to: str = "total", start: Optional[str] = None, end: Optional[str] = None, db: Session = Depends(get_db)):
    """How many items pass each threshold (10% ... 0.001%) and what share of value they cover."""
    dim = _dim(by)
    filters = _filters(request, exclude={by}, db=db)
    start, end = _ranking_periods(request, period, filters)
    level = _drill_level(db, dim, level, parent)

    def query() -> dict:
        return {c: v for c, v in _grouped(db, dim, filters, level, parent).items()
                if _in_view(dim, c, db, parent) and v > 0}

    values = query()
    needed, extra = _needed(db, filters, dim, parent, level)
    status = _ensure(db, needed, extra, start, end, probe=lambda: bool(values))
    if status["fetched_live"]:
        values = query()
    if not status["loaded"]:
        return {"by": by, "period": period, "start": start, "end": end, "span": _span(start, end), "level": level, "total": None, "n_items": 0, "ladder": [], **status}
    view, base = _totals(db, dim, filters, parent, relative_to, values)
    rows = []
    for t in LADDER:  # cutoffs in shares of `base`, coverage of what is in view
        kept = [v for v in values.values() if base and v / base >= t]
        rows.append({"threshold": t, "label": f"≥ {t * 100:g}%", "items": len(kept),
                     "coverage": (sum(kept) / view) if view else 0})
    return {"by": by, "period": period, "start": start, "end": end, "span": _span(start, end), "level": level, "total": view, "base_total": base,
            "n_items": len(values), "ladder": rows, **status}


@router.get("/series")
def series(request: Request, adjust: bool = False, start: Optional[str] = None, end: Optional[str] = None,
           envelope: bool = False, db: Session = Depends(get_db)):
    """A time series for the filtered slice; ``adjust=true`` adds a seasonally adjusted value (STL) for monthly data.

    ``envelope=true`` wraps the rows with the live-fetch flags: ``{"rows": [...], "fetched_live", "loaded"}``.
    """
    filters = _filters(request, exclude={CONFIG["time_dimension"]}, db=db)

    def query() -> list[dict]:
        params: dict = {}
        where = _where(filters, params)
        if start:
            where.append(f'o."{TIME}" >= :start')
            params["start"] = start
        if end:
            where.append(f'o."{TIME}" <= :end')
            params["end"] = end
        sql = (f'SELECT o."{TIME}", SUM({VALUE_EXPR}) FROM "{OBS}" o WHERE {" AND ".join(where) or "1=1"} '
               f'GROUP BY o."{TIME}" ORDER BY o."{TIME}"')
        return [{"period": p, "value": float(v or 0)} for p, v in db.execute(text(sql), params).fetchall()]

    rows = query()
    freq = CONFIG.get("frequency_dimension")
    known = meta(db)["periods"]
    span = known.get(filters.get(freq, [None])[0], []) if freq else known.get("all", [])
    lo, hi = start or (span[0] if span else None), end or (span[-1] if span else None)
    needed, extra = _needed(db, filters)
    status = _ensure(db, needed, extra, lo, hi, probe=lambda: bool(rows))
    if status["fetched_live"]:
        rows = query()
    if adjust and len(rows) >= 36:
        try:
            import pandas as pd
            from statsmodels.tsa.seasonal import STL
            s = pd.Series([r["value"] for r in rows])
            res = STL(s, period=12, robust=True).fit()
            for r, seasonal, trend in zip(rows, res.seasonal, res.trend):
                r["adjusted"] = r["value"] - float(seasonal)
                r["trend"] = float(trend)
                r["seasonal"] = float(seasonal)
        except Exception as exc:  # statsmodels missing or series too irregular
            raise HTTPException(500, f"Seasonal adjustment failed: {exc}")
    if envelope:
        return {"rows": rows if status["loaded"] else [], **status}
    return rows


@router.get("/movers")
def movers(request: Request, by: str, period: str, previous: str, level: Optional[int] = None,
           parent: Optional[str] = None, threshold: Optional[float] = None, limit: int = 10,
           db: Session = Depends(get_db)):
    """Largest increases and decreases between two periods among significant items."""
    dim = _dim(by)
    filters = _filters(request, exclude={by}, db=db)
    level = _drill_level(db, dim, level, parent)
    needed, extra = _needed(db, filters, dim, parent, level)

    def query(p: str) -> dict:
        return _grouped(db, dim, {**filters, CONFIG["time_dimension"]: [p]}, level, parent)

    now, before = query(period), query(previous)
    # Both periods must be loaded, or "is_new" would just mean "not loaded".
    status = _ensure(db, needed, extra, *_window(period, previous), probe=lambda: bool(now) and bool(before))
    if status["fetched_live"]:
        now, before = query(period), query(previous)
    if not status["loaded"]:
        return {"by": by, "period": period, "previous": previous, "up": [], "down": [], "new": [], **status}
    total = sum(v for c, v in now.items() if _in_view(dim, c, db, parent))
    threshold = _default_threshold(dim, level) if threshold is None else threshold
    rows = []
    for c in set(now) | set(before):
        if not _in_view(dim, c, db, parent):
            continue
        a, b = before.get(c, 0.0), now.get(c, 0.0)
        if total and max(a, b) / total < threshold:
            continue
        rows.append({"code": c, "previous": a, "value": b, "change": b - a,
                     "growth": (b - a) / a if a else None, "is_new": a == 0 and b > 0})
    labels = _labels(db, dim, [r["code"] for r in rows])
    for r in rows:
        r["name"] = labels[r["code"]]
    rows.sort(key=lambda r: -r["change"])
    return {"by": by, "period": period, "previous": previous, "threshold": threshold,
            "up": rows[:limit], "down": sorted(rows, key=lambda r: r["change"])[:limit],
            "new": [r for r in rows if r["is_new"]][:limit], **status}


@router.get("/compare")
def compare(request: Request, by: str, period: str, group: Optional[str] = None, db: Session = Depends(get_db)):
    """Values for several items of one dimension (e.g. reporters LU, BE, DE) in one period."""
    dim = _dim(by)
    filters = _filters(request, exclude={by}, db=db)
    filters[CONFIG["time_dimension"]] = [period]
    if group:
        filters[by] = [_normalise(dim, g) for g in group.split(",")]
        _check(db, dim, filters[by])
    values = _grouped(db, dim, filters, None, None)
    labels = _labels(db, dim, list(values))
    total = sum(values.values())
    return sorted(({"code": c, "name": labels[c], "value": v, "share": v / total if total else 0}
                   for c, v in values.items()), key=lambda r: -r["value"])


@router.get("/compare/records")
def compare_records(request: Request, by: str, period: str, base: Optional[str] = None, limit: int = 30,
                    db: Session = Depends(get_db)):
    """One row per member of ``by`` (e.g. reporting countries): its value in ``period`` and its growth
    since ``base`` (default: the first period in the data), ranked by growth. The focus (e.g.
    Luxembourg) is flagged and named with a marker, so a bar chart shows where it stands."""
    dim = _dim(by)
    filters = _filters(request, exclude={by}, db=db)
    freq = CONFIG.get("frequency_dimension")
    periods = meta(db)["periods"]
    span = periods.get(filters.get(freq, [None])[0], []) if freq else periods.get("all", [])
    base = base or (span[0] if span else period)
    now = _grouped(db, dim, {**filters, CONFIG["time_dimension"]: [period]}, None, None)
    before = _grouped(db, dim, {**filters, CONFIG["time_dimension"]: [base]}, None, None)
    codes = [c for c in now if _is_member(dim, c, db) and before.get(c)]
    labels = _labels(db, dim, codes)
    focus = FOCUS.get(by)
    rows = [{"code": c, "name": labels[c] + (" ◀" if c == focus else ""), "value": now[c], "base_value": before[c],
             "growth": round(100 * (now[c] / before[c] - 1), 1), "is_focus": c == focus} for c in codes]
    rows.sort(key=lambda r: -r["growth"])
    return rows[:limit]


@router.get("/specialisation")
def specialisation(request: Request, by: str, period: str, db: Session = Depends(get_db)):
    """Revealed comparative advantage of the focus reporter vs its peer group, per item of ``by``.

    RCA = (focus share of item in its total) / (peer-group share of item in its total).
    Above 1: the focus trades relatively more of that item than its peers.
    """
    cfg = CONFIG.get("comparison")
    if not cfg:
        raise HTTPException(400, "No comparison dimension configured")
    dim = _dim(by)
    cmp_dim = _dim(cfg["dimension"])
    focus = request.query_params.get(cfg["dimension"], DEFAULTS.get(cfg["dimension"]))
    peers = cfg.get("peers") or "auto"
    if peers == "auto":
        col = cmp_dim["column"]
        rows = db.execute(text(f'SELECT DISTINCT "{col}" FROM "{OBS}"')).fetchall()
        peers = [r[0] for r in rows if r[0] != focus and _is_member(cmp_dim, r[0], db)]
    filters = _filters(request, exclude={by, cfg["dimension"]}, db=db)
    filters[CONFIG["time_dimension"]] = [period]
    level = _drill_level(db, dim, None, None)
    f_vals = {c: v for c, v in _grouped(db, dim, {**filters, cfg["dimension"]: [focus]}, level, None).items()
              if _is_member(dim, c, db)}
    p_vals = {c: v for c, v in _grouped(db, dim, {**filters, cfg["dimension"]: peers}, level, None).items()
              if _is_member(dim, c, db)}
    f_tot, p_tot = sum(f_vals.values()), sum(p_vals.values())
    labels = _labels(db, dim, list(f_vals))
    rows = []
    for c, v in f_vals.items():
        if not (f_tot and p_tot and p_vals.get(c)):
            continue
        fs, ps = v / f_tot, p_vals[c] / p_tot
        rows.append({"code": c, "name": labels[c], "value": v, "share": fs, "peer_share": ps, "rca": fs / ps})
    rows.sort(key=lambda r: -r["rca"])
    return {"by": by, "period": period, "focus": focus, "peers": peers, "items": rows}


@router.get("/specialisation/records")
def specialisation_records(request: Request, by: str, period: str, limit: int = 12, db: Session = Depends(get_db)):
    """Top items by RCA (above 1 only) as a flat list for BESSER chart components."""
    rows = specialisation(request, by, period, db)["items"]
    return [{"name": r["name"], "code": r["code"], "rca": round(r["rca"], 2), "value": r["value"]}
            for r in rows if r["rca"] > 1][:limit]
