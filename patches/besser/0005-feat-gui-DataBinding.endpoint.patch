From 632b994aab6b4f8b60acac22da7a7b0bf3fc0d7b Mon Sep 17 00:00:00 2001
From: BESSER STATEC hackathon team <besser@list.lu>
Date: Wed, 14 Oct 2026 13:24:56 +0200
Subject: [PATCH 5/5] feat(gui): DataBinding.endpoint

A chart or metric card can read from any backend endpoint (for example an
analytics API), not only the CRUD collection of its class. Without it, a
chart on a large table downloads every row and aggregates in the browser.
Carried by gui_model_to_code and both web-editor converters; also fixes
metric-card titles lost in buml_to_json and chart-level bindings dropped
by json_to_buml.
---

diff --git a/besser/BUML/metamodel/gui/binding.py b/besser/BUML/metamodel/gui/binding.py
index 99c2bb2..63938cc 100644
--- a/besser/BUML/metamodel/gui/binding.py
+++ b/besser/BUML/metamodel/gui/binding.py
@@ -44,6 +44,9 @@ class DataBinding(Element):
         aggregation (DataAggregation | str, optional): How the bound records are
             reduced to one value per label: a metric card's value, or a chart's
             value per ``label_field`` group. Defaults to None (no aggregation).
+        endpoint (str, optional): Backend path to read the records from instead of the
+            domain concept's CRUD collection (``/<class>/``), e.g. an analytics endpoint
+            such as ``/insights/ranking/records?by=partner&period=2025``. Defaults to None.
 
     Attributes:
         name (str): Name of the data binding.
@@ -56,11 +59,13 @@ class DataBinding(Element):
         data_field_path (str): Dot notation path for nested data field.
         filter_expression (str): Raw filter expression string.
         aggregation (DataAggregation | None): How the bound records are aggregated.
+        endpoint (str | None): Backend path overriding the domain concept's collection.
     """
     def __init__(self, domain_concept: Class, name: str = None, visualization_attrs: set[Property] = None,
                  label_field: Property = None, data_field: Property = None,
                  data_filter: Constraint = None, label_field_path: str = None, data_field_path: str = None,
-                 filter_expression: str = None, aggregation: DataAggregation = None):
+                 filter_expression: str = None, aggregation: DataAggregation = None,
+                 endpoint: str = None):
         super().__init__()
         self.name = name or f"{domain_concept.name if domain_concept else 'Unknown'}DataBinding"
         self.domain_concept = domain_concept
@@ -72,6 +77,19 @@ class DataBinding(Element):
         self.data_field_path = data_field_path    # For nested fields like "measure.value"
         self.filter_expression = filter_expression  # Raw filter string from UI
         self.aggregation = aggregation
+        self.endpoint = endpoint
+
+    @property
+    def endpoint(self) -> str | None:
+        """str | None: Backend path overriding the domain concept's collection."""
+        return self._endpoint
+
+    @endpoint.setter
+    def endpoint(self, endpoint: str | None) -> None:
+        """Set the backend path (relative to the API root, or an absolute URL)."""
+        if endpoint is not None and not isinstance(endpoint, str):
+            raise TypeError("endpoint must be a string or None")
+        self._endpoint = endpoint
 
     @property
     def name(self) -> str:
